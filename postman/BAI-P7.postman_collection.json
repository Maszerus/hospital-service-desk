          "name": "16 T6 — rzeczywiste nagłówki i Set-Cookie",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/lab/test-info",
            "description": "Sprawdź Headers: Content-Security-Policy, X-Content-Type-Options, X-Frame-Options, Set-Cookie. Secure=true sprawdzamy wyłącznie dla HTTPS w trybie secure."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
                  "const j=pm.response.json();",
                  "pm.test('Aktywny tryb: secure',()=>pm.expect(j.mode).to.eql('secure'));",
                  "pm.collectionVariables.set('csrfToken',j.csrfToken);",
                  "pm.test('Token tej sesji dostępny',()=>pm.expect(j.csrfToken).to.be.a('string').and.not.empty);",
                  "pm.test('CSP: aktywne',()=>pm.expect(!!pm.response.headers.get('Content-Security-Policy')).to.eql(true));",
                  "pm.test('SameSite: strict',()=>pm.expect(j.cookie.sameSite).to.eql('strict'));",
                  "pm.test('HttpOnly konfiguracja',()=>pm.expect(j.cookie.httpOnly).to.eql(true));",
                  "const setCookie=pm.response.headers.get('Set-Cookie')||'';",
                  "pm.test('Rzeczywiste Set-Cookie: HttpOnly',()=>pm.expect(setCookie).to.match(/;\\s*HttpOnly/i));",
                  "pm.test('Rzeczywiste Set-Cookie: SameSite',()=>pm.expect(setCookie).to.match(/SameSite=Strict/i));",
                  "const https=pm.variables.replaceIn('{{baseUrl}}').startsWith('https:');",
                  "const expectSecure=true&&https;",
                  "pm.test('Secure zgodne z trybem i protokołem',()=>pm.expect(j.cookie.secure).to.eql(expectSecure));",
                  "pm.test('Set-Cookie: rzeczywista flaga Secure',()=>pm.expect(/;\\s*Secure(?:;|$)/i.test(setCookie)).to.eql(expectSecure));",
                  "pm.test('nosniff',()=>pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.eql('nosniff'));",
                  "pm.test('SAMEORIGIN',()=>pm.expect(pm.response.headers.get('X-Frame-Options')).to.eql('SAMEORIGIN'));",
                  "if(true&&!https)console.warn('HTTP: test Secure na true nie został wykonany. Powtórz kolekcję na https://localhost:3443.');"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false
          }
