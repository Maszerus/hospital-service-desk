{
  "name": "hospital-service-desk-bai",
  "version": "0.7.0",
  "description": "BAI 2026 Security Lab: runtime vulnerable/secure modes with real XSS/CSRF tests",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "test": "node --test",
    "https:cert": "sh scripts/https-cert.sh",
    "start:https": "TLS_KEY=.certs/localhost-key.pem TLS_CERT=.certs/localhost-cert.pem node app.js",
    "demo:csrf": "node scripts/csrf-server.js",
    "test:browser": "node scripts/browser-check.cjs",
    "test:postman": "node scripts/postman-check.cjs",
    "postman:generate": "node scripts/generate-postman.cjs",
    "test:curl": "node scripts/curl-check.cjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
